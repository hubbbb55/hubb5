-- Ensure the path exists or create it safely
local workspace = game:GetService("Workspace")

-- Function to get or create workspace.VER.Highlight
local function getOrCreateHighlight()
	-- Check if VER folder/model exists in workspace, create if missing
	local verFolder = workspace:FindFirstChild("VER")
	if not verFolder then
		verFolder = Instance.new("Folder")
		verFolder.Name = "VER"
		verFolder.Parent = workspace
	end

	-- Check if Highlight exists inside VER, create if missing
	local highlight = verFolder:FindFirstChildOfClass("Highlight")
	if not highlight then
		highlight = Instance.new("Highlight")
		highlight.Name = "Highlight"
		highlight.Adornee = verFolder -- Adjust adornee as needed
		highlight.Parent = verFolder
	end

	return highlight
end

-- Execute and configure the highlight
local highlightInstance = getOrCreateHighlight()

-- Example property adjustments
highlightInstance.FillColor = Color3.fromRGB(0, 170, 255)
highlightInstance.OutlineColor = Color3.fromRGB(255, 255, 255)
highlightInstance.FillTransparency = 0.5

print("Highlight path ready:", highlightInstance:GetFullName())
